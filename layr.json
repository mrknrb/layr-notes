{
  "id": "notes",
  "name": "Notes",
  "version": "0.1.1",
  "description": "Notes in Markdown with a live preview, search and pinned notes.",
  "author": "layr",
  "layr": "^0.1",
  "icon": "sticky_note_2",
  "permissions": ["data"],
  "sync": true,
  "panels": [{ "id": "main", "title": "Notes", "page": "panels/main.html", "icon": "sticky_note_2" }],
  "commands": [
    { "id": "open", "title": "Notes: Open", "panel": "main" },
    { "id": "new", "title": "Notes: New note", "panel": "main", "params": { "new": true } }
  ],
  "menus": [
    { "menu": "File", "command": "new", "group": "1" },
    { "menu": "View", "command": "open" }
  ],
  "keybindings": [{ "key": "ctrl+alt+n", "command": "new" }]
}
